HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PINECONE_API_KEY=pcsk_your_key
PINECONE_INDEX=asr-global-solutions
PINECONE_NAMESPACE=website
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
ALLOWED_ORIGINS=http://localhost:5500,https://www.asrglobalsolutions.com
